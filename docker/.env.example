# 敏感参数模板：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，禁止提交）
# 本地 IDEA 启动：在 Run Configuration 的 Environment variables 里填同样的键值，
# 或安装 EnvFile 插件后在 Run Configuration 中加载本文件

# JWT 密钥（>=32 字节），必填
JWT_SECRET=

# MySQL root 密码（必填；MYSQL_ROOT_PASSWORD 与 DB_PASSWORD 保持一致）
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# Redis 访问密码（必填；IDEA 本机运行也需设置同名变量）
REDIS_PASSWORD=

# SeaweedFS S3 访问凭证（必填；须与 docker/seaweedfs/s3.json 内凭证一致，改动两处同步）
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 邮件验证码（QQ 邮箱 SMTPS 465；授权码在 QQ 邮箱「设置-账户-POP3/SMTP服务」获取）
MAIL_ENABLED=true
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# 可选：AI（Hermes）API Key
HERMES_API_KEY=

# 可选：通话 TURN（coturn 共享密钥，需与 coturn 服务的 static-auth-secret 一致）
TURN_SHARED_SECRET=
# TURN 对外地址主机名/IP（客户端可达的公网或局域网地址；留空时为 localhost，仅本机可用）
TURN_PUBLIC_HOST=
# TURN external-ip（中继候选地址；本机开发填宿主机局域网 IP）
TURN_EXTERNAL_IP=
# 对外服务绑定的宿主机 IP（网关 8080 / 应用 8190-8191 / 9190-9191 / coturn 3478 与 relay 端口段）
APP_HOST_IP=192.168.0.2
